{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:e2e)",
      "Bash(npx playwright test:*)",
      "Bash(npm run build)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm add:*)",
      "Bash(npm ci:*)",
      "Bash(npx playwright install:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.secret)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(more .env*)",
      "Bash(Get-Content .env*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint --silent 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
